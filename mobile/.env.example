# Copy to .env before running the app. Both values are baked into the JavaScript
# bundle by Expo, so neither one is a secret: EXPO_PUBLIC_ prefixed variables are
# public by definition. See SECURITY.md.

# Optional. Leave unset to auto-detect the backend from the Expo dev server host,
# which is what makes LAN mode and a dev tunnel work without hardcoding an IP.
# Set it when the phone cannot reach your machine directly.
# EXPO_PUBLIC_API_URL=https://your-tunnel-host

# Must equal APP_KEY_MOBILE in the backend .env, or every request is refused with
# 401 invalid_app_key before anything else runs.
EXPO_PUBLIC_APP_KEY=change-me-mobile

# Must equal APP_KEY_WEB in the backend .env. Used only when this bundle runs
# in a browser (expo start --web), where it registers as the 'web' app rather
# than 'mobile', because the server allows each app id only its own platforms.
EXPO_PUBLIC_APP_KEY_WEB=change-me-web
