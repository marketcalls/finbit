# FinBit environment template.
# Copy this file to .env at the repo root and fill in your real key.
# The .env file is git-ignored. Never commit a real key.

# ---------------------------------------------------------------------------
# Perplexity Agent API
# ---------------------------------------------------------------------------
# Required for ingestion. The API starts without it, only the news pipeline
# refuses to run.
PERPLEXITY_API_KEY=pplx-your-key-here

# Model id used for story discovery.
PERPLEXITY_MODEL=perplexity/sonar

# Base URL. The pipeline posts to <base>/v1/agent.
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# The first call with a new JSON schema can take 10 to 30 seconds, so keep this
# generous.
PERPLEXITY_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# Storage and transport
# ---------------------------------------------------------------------------
# SQLite file. A relative path is resolved against the backend directory.
DB_PATH=finbit.db

# Comma separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Ingestion schedule
# ---------------------------------------------------------------------------
# Cost note: one Perplexity query costs roughly 0.006 USD. With the defaults
# below (4 queries every 15 minutes) that is about 16 queries per hour, close
# to 0.10 USD per hour. Lower INGEST_QUERIES_PER_CYCLE or raise
# INGEST_INTERVAL_MINUTES to spend less. Set INGEST_ENABLED=false to run the
# API on cached articles only.
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=15
INGEST_QUERIES_PER_CYCLE=4
INGEST_MAX_STORIES_PER_QUERY=6
INGEST_CONCURRENCY=3

# How often stored articles are rescored so the feed decays.
RESCORE_INTERVAL_MINUTES=30
