# FinBit environment template.
# Copy this file to .env at the repo root and fill in your real key.
# The .env file is git-ignored. Never commit a real key.

# ---------------------------------------------------------------------------
# Perplexity Agent API
# ---------------------------------------------------------------------------
# Required for ingestion. The API starts without it, only the news pipeline
# refuses to run.
PERPLEXITY_API_KEY=pplx-your-key-here

# Model id used for story discovery.
PERPLEXITY_MODEL=perplexity/sonar

# Base URL. The pipeline posts to <base>/v1/agent.
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# The first call with a new JSON schema can take 10 to 30 seconds, so keep this
# generous.
PERPLEXITY_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------------------
# Storage and transport
# ---------------------------------------------------------------------------
# SQLite file. A relative path is resolved against the backend directory.
DB_PATH=finbit.db

# Comma separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Ingestion schedule
# ---------------------------------------------------------------------------
# Cost note: one Perplexity query costs roughly 0.006 USD. With the defaults
# below (4 queries every 15 minutes) that is about 16 queries per hour, close
# to 0.10 USD per hour. Lower INGEST_QUERIES_PER_CYCLE or raise
# INGEST_INTERVAL_MINUTES to spend less. Set INGEST_ENABLED=false to run the
# API on cached articles only.
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=15
INGEST_QUERIES_PER_CYCLE=4
INGEST_MAX_STORIES_PER_QUERY=6
# Concurrent Agent API requests. The live account answers with
# x-ratelimit-limit: 1, so anything above 1 earns a 429. Keep this at 1.
INGEST_CONCURRENCY=1

# How often stored articles are rescored so the feed decays.
RESCORE_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# Security (CONTRACT_MOBILE_ADMIN.md section 3.9)
# ---------------------------------------------------------------------------
# Two app keys so mobile and web can be rotated independently. They ship inside
# the app bundles (EXPO_PUBLIC_APP_KEY and VITE_APP_KEY), so they are public
# values by definition: they raise the cost of calling the API from a script,
# they do not prove app identity.
APP_KEY_MOBILE=change-me-mobile
APP_KEY_WEB=change-me-web

# 32 bytes of randomness. Every device secret is derived from this key, so the
# server stores no secrets. Rotating it invalidates every registered device,
# which is the emergency lever. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
DEVICE_MASTER_KEY=change-me-32-bytes-of-random

# Signs the access tokens. Rotating it logs every device and admin out. Use at
# least 32 bytes: HS256 warns below that. Generate one the same way:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-long-random

# Optional. When both are set and no admin exists yet, startup creates this one
# account and logs the username only. Leave them empty and use the CLI instead:
#   uv run python -m app.admin_cli create-admin --username alice
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Replay protection. A signed request more than SIGNATURE_SKEW_SECONDS away
# from the server clock is rejected, and a nonce is remembered for
# NONCE_TTL_SECONDS.
SIGNATURE_SKEW_SECONDS=120
NONCE_TTL_SECONDS=300

# Development-only switch. false degrades every request to an app key plus a
# bearer token, with no HMAC signature and no replay protection, so the API can
# be driven from /docs. It logs a loud warning at startup. Never ship false.
# With true, startup refuses to run until APP_KEY_MOBILE, APP_KEY_WEB,
# DEVICE_MASTER_KEY and JWT_SECRET all hold real values.
REQUIRE_SIGNED_REQUESTS=true
