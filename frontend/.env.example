# FinBit web app environment.
#
# Vite only exposes variables prefixed with VITE_ to the bundle, and everything
# it exposes is public: it is compiled into the JavaScript every visitor
# downloads. Never put an API key, a password or any other secret in this file
# or in .env.local. The backend secrets live in the repo root .env.
#
# Copy this file to .env.local, which Vite loads in every mode and .gitignore
# already covers. A plain "npm run dev" needs no copy: .env.development carries
# working defaults for it. A production build does: "npm run build" runs in
# production mode and never reads .env.development, so without .env.local or
# these variables in the build environment the bundle ships with no app key and
# the deployed site is refused by the API.

# Base URL of the FinBit API, without a trailing slash.
# Defaults to http://127.0.0.1:8000 when unset.
VITE_API_BASE=http://127.0.0.1:8000

# Must equal APP_KEY_WEB in the repo root .env. This is the web half of the two
# app keys (CONTRACT_MOBILE_ADMIN.md section 3.2), so the web key can be rotated
# without touching the mobile app. It is a build-time public value by
# definition, not a secret: it raises the cost of calling the API from something
# that is not this app, and nothing more. Leaving it unset or stale makes the
# API answer 401 invalid_app_key to every request.
VITE_APP_KEY=change-me-web
