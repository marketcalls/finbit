# Loaded by "npm run dev". Copy .env.example to .env.local to override locally.

VITE_API_BASE=http://127.0.0.1:8000

# APP_KEY_WEB from the repo root .env. A build-time public value by definition
# (CONTRACT_MOBILE_ADMIN.md section 3.9), not a secret. It must match the value
# the backend has, or every request comes back 401 invalid_app_key.
VITE_APP_KEY=change-me-web
